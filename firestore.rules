rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SUBSTITUA pelo UID real da conta Joao antes de publicar.
    function owner() { return request.auth != null && request.auth.uid == '1VKQY4YpScWwJnpPBVjp8J5J6Cw1'; }
    function admin() { return owner() || (request.auth != null && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.admin == true); }
    function signed() { return request.auth != null; }
    function validState(s) {
      return s is map && s.money is number && s.money >= 0 && s.money <= 900000000000000
        && s.hits is int && s.hits >= 0 && s.hits <= 1000000000
        && s.rebirth is int && s.rebirth >= 0 && s.rebirth <= 1000000
        && s.level is int && s.level >= 1 && s.level <= 20;
    }
    match /players/{uid} {
      allow read: if signed(); // Ranking público para jogadores autenticados.
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username','usernameLower','state','resetVersion','createdAt','updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 20
        && request.resource.data.usernameLower is string
        && request.resource.data.resetVersion == 0
        && validState(request.resource.data.state)
        && request.resource.data.state.money == 0 && request.resource.data.state.hits == 0;
      // Spark: o cliente salva o próprio jogo. NÃO impede trapaças na economia.
      allow update: if admin() || (signed() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','updatedAt','resetVersion','handle'])
        && request.resource.data.resetVersion == resource.data.resetVersion
        && validState(request.resource.data.state)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['handle']) || (
            !resource.data.keys().hasAny(['handle'])
            && request.resource.data.handle is string
            && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
            && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid
        )));
      allow delete: if false;
    }
    // IDs únicos e permanentes. A reserva e o campo handle do perfil
    // devem ser criados juntos no mesmo batch; um UID não pode escolher outro depois.
    match /handles/{handleId} {
      allow get: if signed();
      allow list: if false;
      allow create: if signed()
        && handleId.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && !get(/databases/$(database)/documents/players/$(request.auth.uid)).data.keys().hasAny(['handle'])
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.handle == handleId;
      allow update, delete: if false;
    }
    // Só ADMIN escreve permissões do pet exclusivo. Jogadores podem consultar apenas a sua.
    match /adminPets/{uid} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['enabled','updatedAt'])
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }
    match /roles/{uid} {
      allow get: if signed();
      allow list: if false;
      allow create, update: if owner() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['admin'])
        && request.resource.data.admin is bool;
      allow delete: if owner() && uid != request.auth.uid;
    }
    // Selos publicos: apenas o dono pode aprovar YouTuber ou Verificado.
    // O selo de ADMIN vem de roles; o de DONO vem do UID fixo.
    match /verifications/{uid} {
      allow get: if signed();
      allow list: if false;
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['badge','updatedAt'])
        && request.resource.data.badge in ['youtuber','verified','none'];
      allow delete: if owner();
    }
    match /global/{docId} {
      allow read: if signed() && docId in ['event','announcement','reload'];
      allow create, update: if admin() && docId in ['event','announcement','reload']
        && (docId == 'reload' ? (request.resource.data.keys().hasOnly(['version','updatedAt']) && request.resource.data.version is string && request.resource.data.version.size() <= 30) : docId == 'event' ? (
          request.resource.data.keys().hasOnly(['kind','endsAt','multiplier','updatedAt'])
          && request.resource.data.kind in ['coins','luck','aurora','galaxy','angel','ember','tide','clock','none']
          && request.resource.data.endsAt is number
          && request.resource.data.endsAt >= 0
          && request.resource.data.multiplier is number
          && request.resource.data.multiplier >= 1
          && request.resource.data.multiplier <= 1000
        ) : (
          request.resource.data.keys().hasOnly(['message','updatedAt'])
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 180
        ));
      allow delete: if false;
    }

    // Pedidos de amizade: dono do pedido envia; destinatário aceita.
    match /friendships/{pairId} {
      allow read, list: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['members','sender','receiver','status','senderName','receiverName','createdAt'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.sender != request.resource.data.receiver
        && request.resource.data.members.hasAll([request.resource.data.sender,request.resource.data.receiver])
        && request.resource.data.status == 'pending'
        && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 20
        && request.resource.data.receiverName is string && request.resource.data.receiverName.size() <= 20
        && (pairId == request.resource.data.sender + '_' + request.resource.data.receiver
            || pairId == request.resource.data.receiver + '_' + request.resource.data.sender);
      allow update: if signed() && request.auth.uid == resource.data.receiver
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt'])
        && request.resource.data.status == 'accepted';
      allow delete: if signed() && request.auth.uid in resource.data.members;
    }
    // Dados temporários de presença, utilizados para jogar no mesmo mundo.
    match /presence/{playerUid} {
      allow read: if signed();
      allow create, update: if signed() && request.auth.uid == playerUid
        && request.resource.data.keys().hasOnly(['username','world','weapon','lastSeen','x','y','shotAt','roomId'])
        && request.resource.data.username is string && request.resource.data.username.size() <= 20
        && request.resource.data.world is int && request.resource.data.world >= 0 && request.resource.data.world <= 7
        && request.resource.data.weapon is int && request.resource.data.weapon >= 0 && request.resource.data.weapon <= 12
        && request.resource.data.lastSeen == request.time
        && request.resource.data.roomId is string && request.resource.data.roomId.size() <= 90
        && (request.resource.data.roomId == request.auth.uid || (exists(/databases/$(database)/documents/partyInvites/$(request.resource.data.roomId+'_'+request.auth.uid)) && get(/databases/$(database)/documents/partyInvites/$(request.resource.data.roomId+'_'+request.auth.uid)).data.status == 'accepted'));
      allow delete: if signed() && request.auth.uid == playerUid;
    }
    // Mensagens públicas por mundo, autenticadas; somente quem envia pode criar.
    match /roomMessages/{messageId} {
      allow read, list: if signed() && (resource.data.roomId == request.auth.uid || (exists(/databases/$(database)/documents/partyInvites/$(resource.data.roomId+'_'+request.auth.uid)) && get(/databases/$(database)/documents/partyInvites/$(resource.data.roomId+'_'+request.auth.uid)).data.status == 'accepted'));
      allow create: if signed()
        && (request.resource.data.roomId == request.auth.uid || (exists(/databases/$(database)/documents/partyInvites/$(request.resource.data.roomId+'_'+request.auth.uid)) && get(/databases/$(database)/documents/partyInvites/$(request.resource.data.roomId+'_'+request.auth.uid)).data.status == 'accepted'))
        && request.resource.data.keys().hasOnly(['uid','username','world','text','sentAt','roomId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1 && request.resource.data.username.size() <= 20
        && request.resource.data.world is int
        && request.resource.data.world >= 0 && request.resource.data.world <= 7
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 180
        && request.resource.data.sentAt == request.time
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() <= 90;
      allow update, delete: if false;
    }

    // Convite privado: somente quem recebe pode aceitar. Apenas amigos podem ser convidados.
    match /partyInvites/{inviteId} {
      allow get, list: if signed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signed() && request.resource.data.keys().hasOnly(['from','to','roomId','world','status','createdAt','fromName','friendshipId'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.world is int && request.resource.data.world >= 0 && request.resource.data.world <= 7
        && request.resource.data.roomId == request.auth.uid
        && inviteId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 20
        && request.resource.data.friendshipId is string
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId))
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.members.hasAll([request.auth.uid,request.resource.data.to]);
      allow update: if signed() && request.auth.uid == resource.data.to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted';
      allow delete: if signed() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
